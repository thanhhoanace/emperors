    {"id": "huai_scavenge", "phase": "post_turn", "priority": 40, "once": true, "when": {"owner": {"huai": "zhu_yuanzhang"}}, "emit": {"kind": "gate", "text": "Chu ở Chung Ly, khe Hoài giữa Tào và Ngô."}, "actors": ["zhu_yuanzhang", "zhang_liao", "sun_quan"], "shot": {"camera": "zhongli_huai", "seconds": 5}},
